{
  "name": "@shahdadk/dex",
  "version": "0.0.1",
  "description": "Dex is your persistent developer.",
  "type": "module",
  "bin": {
    "dex": "./dist/cli.js"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "docs",
    ".env.example"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "start:cloud": "node dist/cloud/runtime/main.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@google-cloud/cloud-sql-connector": "1.10.0",
    "@google-cloud/tasks": "^7.0.0",
    "commander": "^14.0.0",
    "execa": "^9.6.0",
    "google-auth-library": "^11.0.2",
    "modal": "^0.9.0",
    "pg": "^8.23.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "license": "MIT"
}
