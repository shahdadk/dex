# Dex Cloud service boundary. Never commit real values.
DEX_CLOUD_URL=
DEX_DEVICE_ID=
DEX_DEVICE_KEY_ID=
DEX_CLOUD_SERVER_KEYS_JSON=[]
DEX_SENDBLUE_LINE=
# Existing Appfi deployments may provide SENDBLUE_NUMBER instead.
SENDBLUE_NUMBER=

# Dex Cloud runtime. Existing values should come from the deployment secret manager.
NODE_ENV=production
DEX_DATABASE_URL=
DEX_DATABASE_SSL_MODE=require
# GCP alternative to DEX_DATABASE_URL: automatic IAM authentication via the
# Cloud SQL Node.js Connector. Set the three required values together.
DEX_CLOUD_SQL_INSTANCE=
DEX_CLOUD_SQL_DATABASE=
DEX_CLOUD_SQL_IAM_USER=
DEX_CLOUD_SQL_IP_TYPE=PUBLIC
DEX_OWNER_ALLOWLIST_JSON=[]
# Set exactly one private-key source.
DEX_SERVER_SIGNING_PRIVATE_KEY=
DEX_SERVER_SIGNING_PRIVATE_KEY_FILE=
DEX_SERVER_SIGNING_PUBLIC_KEY=
DEX_SERVER_SIGNING_KEY_ID=
DEX_INTERNAL_SECRET=
DEX_SENDBLUE_WEBHOOK_SECRET=
SENDBLUE_WEBHOOK_SECRET=
SENDBLUE_API_KEY_ID=
SENDBLUE_API_SECRET_KEY=
# Existing Appfi name accepted as an alias.
SENDBLUE_API_SECRET=
DEX_SENDBLUE_STATUS_CALLBACK=
DEX_CLOUD_HOST=0.0.0.0
DEX_CLOUD_PORT=8080

# Existing model/transport credentials are referenced by the cloud runtime.
GEMINI_API_KEY=
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
DEX_MODAL_SECRET_NAME=dex-workers
# Cloud Codex account authentication (no OpenAI API key): dex setup seeds this
# private Modal Volume from ~/.codex/auth.json and mounts it as CODEX_HOME.
DEX_MODAL_CODEX_AUTH_VOLUME=dex-codex-auth
DEX_HANDOFF_SIGNING_KEY=

# Optional local overrides.
DEX_HOME=
CLAUDE_MEM_URL=
DEX_DEFAULT_REPOSITORY=
